# ---------------------------------------------------------------------------
# LynoraLink — Variables d'environnement
# Copier vers .env.local pour la configuration locale.
# Remplacer les valeurs de démonstration avant tout déploiement.
# ---------------------------------------------------------------------------

# --- Base de données (PostgreSQL / Neon) ---
# PostgreSQL local isolé (scripts/local-postgres.ps1, port 5433)
DATABASE_URL="postgresql://lynora@127.0.0.1:5433/lynora?schema=public"
DIRECT_URL="postgresql://lynora@127.0.0.1:5433/lynora?schema=public"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="CHANGE_ME_generate_a_secure_random_value"

# --- Paddle (clés privées et price IDs, backend uniquement) ---
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
# LynoAI Premium : 10 USD/mois, 120 USD/an.
PADDLE_COPILOT_PRICE_ID_MONTHLY=""
PADDLE_COPILOT_PRICE_ID_YEARLY=""
# Vérification vendeur : 15 USD/mois, 180 USD/an.
PADDLE_SELLER_VERIFICATION_PRICE_ID_MONTHLY=""
PADDLE_SELLER_VERIFICATION_PRICE_ID_YEARLY=""
PADDLE_ENVIRONMENT="sandbox"
# Active les ventes marketplace en production uniquement après approbation écrite de Paddle.
PADDLE_MARKETPLACE_APPROVED="false"
# --- Paddle.js (jeton client publiable sur le frontend) ---
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""
NEXT_PUBLIC_PADDLE_ENVIRONMENT="sandbox"
# Webhook Paddle : https://<API_BACKEND_URL>/api/payments/paddle/webhook

# --- OAuth Google ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- OAuth Facebook ---
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# --- AI Copilot providers (API only; configure at least one) ---
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_AI_API_TOKEN=""
# Alternative token name accepted by the API:
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_AI_MODEL="@cf/meta/llama-3.1-8b-instruct"

# Configuration email (Brevo)
EMAIL_PROVIDER="brevo"
NO_REPLY_EMAIL="noreply@lynoralink.com"
BREVO_API_KEY=""
BREVO_FROM_EMAIL="noreply@lynoralink.com"
BREVO_FROM_NAME="LynoraLink"
# Alternative provider for password reset emails
RESEND_API_KEY=""
EMAIL_FROM="LynoraLink <no-reply@lynoralink.app>"
SUPPORT_EMAIL_TO="contact@lynoralink.com"
# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_BACKEND_URL="http://localhost:4000"
CODING_WS_URL="ws://localhost:4001"
CODING_WS_PORT="4001"

# --- Cloudinary (avatars et fichiers) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Firebase (optionnel, pour notifications push / analytics) ---
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
