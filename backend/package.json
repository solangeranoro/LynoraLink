{
  "name": "lynoralink-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "start:collaboration": "node --import ./scripts/load-root-env.mjs --import tsx scripts/coding-collaboration.ts",
    "type-check": "tsc --noEmit",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:migrate": "node scripts/prisma.mjs migrate dev",
    "db:deploy": "node scripts/prisma.mjs --production migrate deploy",
    "db:status": "node scripts/prisma.mjs migrate status"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "dotenv": "^16.4.7",
    "lib0": "^0.2.119",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "node-pty": "^1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.19.1",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.2",
    "prisma": "^5.19.1",
    "typescript": "^5.6.2"
  }
}
